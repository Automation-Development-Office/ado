apiVersion: apps/v1
kind: Deployment
metadata:
  name: zabbix-web
  namespace: {{ name_space }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: zabbix-web
  template:
    metadata:
      labels:
        app: zabbix-web
    spec:
      containers:
        - name: zabbix-web
          image: {{ zabbix_web_image }}
          ports:
            - containerPort: 8080
          env:
            - name: ZBX_SERVER_HOST
              value: zabbix-server.{{ name_space }}.svc.cluster.local
            - name: DB_SERVER_HOST
              value: mariadb.{{ name_space }}.svc.cluster.local
            - name: MYSQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-database
            - name: MYSQL_USER
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-user
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-password
            - name: PHP_TZ
              value: UTC
            - name: ZBX_SERVER_NAME
              value: OpenShift Zabbix
---
apiVersion: v1
kind: Service
metadata:
  name: zabbix-web
  namespace: {{ name_space }}
spec:
  selector:
    app: zabbix-web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
