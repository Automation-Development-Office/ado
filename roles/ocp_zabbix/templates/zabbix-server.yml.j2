apiVersion: apps/v1
kind: Deployment
metadata:
  name: zabbix-server
  namespace: {{ name_space }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: zabbix-server
  template:
    metadata:
      labels:
        app: zabbix-server
    spec:
      containers:
        - name: zabbix-server
          image: {{ zabbix_server_image }}
          ports:
            - containerPort: 10051
          env:
            - name: DB_SERVER_HOST
              value: mariadb.{{ name_space }}.svc.cluster.local
            - name: MYSQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-database
            - name: MYSQL_USER
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-user
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-password
---
apiVersion: v1
kind: Service
metadata:
  name: zabbix-server
  namespace: {{ name_space }}
spec:
  selector:
    app: zabbix-server
  ports:
    - port: 10051
      targetPort: 10051
