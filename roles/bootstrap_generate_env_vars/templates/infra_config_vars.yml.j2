{% set preflight_openshift = generate_env_vars_preflight.openshift | default({}) %}
{% set resolved_app_domain = preflight_openshift.apps_domain | default(generate_env_vars_prompt_ocp_domain.user_input | default('', true), true) %}
{% set resolved_app_domain_alt = preflight_openshift.apps_domain_alt | default(resolved_app_domain, true) %}
{% set resolved_skip_tls = preflight_openshift.skip_tls_verify | default(true) | bool %}
---
host: "{{ preflight_openshift.api_host | default(generate_env_vars_prompt_ocp_host.user_input | default('', true), true) }}"
domain: "{{ generate_env_vars_base_domain }}"
app_domain: "{{ resolved_app_domain }}"
apps_domain: "{{ resolved_app_domain }}"
app_domain_alt: "{{ resolved_app_domain_alt }}"
apps_domain_alt: "{{ resolved_app_domain_alt }}"
skip_tls_verify: {{ resolved_skip_tls | lower }}
verify_ssl: {{ (not resolved_skip_tls) | lower }}
validate_certs: {{ (not resolved_skip_tls) | lower }}
