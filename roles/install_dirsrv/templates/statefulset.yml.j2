---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ statefulset_name }}
  namespace: {{ install_dirsrv_target_namespace }}
spec:
  serviceName: dirsrv-internal-svc
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
  replicas: {{ expected_replicas | int }}
  selector:
    matchLabels: {{ install_dirsrv_selector_effective | to_nice_json }}
  template:
    metadata:
      labels: {{ install_dirsrv_selector_effective | to_nice_json }}
    spec:
      serviceAccountName: {{ sa_name }}
      securityContext:
        runAsUser: 389
        runAsGroup: 389
        fsGroup: 389
        fsGroupChangePolicy: OnRootMismatch
      initContainers:
        - name: dirsrv-init-container
          image: {{ init_image | to_json }}
          imagePullPolicy: IfNotPresent
          command: ["sh", "-c", "chown -R 389:389 /data || true"]
          volumeMounts:
            - name: dirsrv-data
              mountPath: /data
      containers:
        - name: dirsrv-container
          image: {{ ocp_dirsrv_image | to_json }}
          env:
            - name: DS_DM_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ dm_secret_name }}
                  key: {{ dm_secret_key }}
            - name: DS_SUFFIX_NAME
              value: {{ install_dirsrv_ds_suffix_effective | string | to_json }}
            - name: DS_ERRORLOG_LEVEL
              value: {{ ds_errorlog_level | string | to_json }}
            - name: DS_REINDEX
              value: {{ ds_reindex | string | to_json }}
            - name: DS_STARTUP_TIMEOUT
              value: {{ ds_startup_timeout | string | to_json }}
          ports: {{ install_dirsrv_container_ports | to_nice_json }}
          readinessProbe:
            tcpSocket:
              port: {{ ldap_port | int }}
            initialDelaySeconds: 15
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: {{ ldap_port | int }}
            initialDelaySeconds: 30
            periodSeconds: 10
          volumeMounts:
            - name: dirsrv-data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: dirsrv-data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: {{ pvc_size | to_json }}
        storageClassName: {{ install_dirsrv_storage_class_name_effective | to_json }}
