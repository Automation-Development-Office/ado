{% raw %}
{
  "annotations": {
    "list": []
  },
  "description": "RHBK / Keycloak Micrometer metrics (jvm_*, http_server_*). Lab IdP runs on Prod; use the Cluster dropdown if both Prometheus datasources expose metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "RHBK scrapes **Micrometer** metrics from the management port (`/metrics`).\n\n- **Memory / CPU / HTTP**: from `jvm_*`, `process_*`, `http_server_*`\n- **Login/realm panels from community dashboard 10441 will stay empty** unless the Keycloak Metrics SPI is installed (this lab does not ship those `keycloak_*` series).\n- Select **K8S = Openshift-Prod** (or Dev on the Dev dashboard)."
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(process_uptime_seconds{namespace=~\"$namespace\", pod=~\"$pod\"}) or max(process_uptime_seconds{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Live threads",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(jvm_threads_live_threads{namespace=~\"$namespace\", pod=~\"$pod\"}) or max(jvm_threads_live_threads{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Process CPU",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(process_cpu_usage{namespace=~\"$namespace\", pod=~\"$pod\"}) or max(process_cpu_usage{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", namespace=~\"$namespace\", pod=~\"$pod\"}) or sum(jvm_memory_used_bytes{area=\"heap\", exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Non-heap used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\", namespace=~\"$namespace\", pod=~\"$pod\"}) or sum(jvm_memory_used_bytes{area=\"nonheap\", exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM memory used (heap / non-heap)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (area) (jvm_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"}) or sum by (area) (jvm_memory_used_bytes{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP server request rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "all requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"4..\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\", status=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request duration (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))) or histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) or sum(rate(jvm_gc_pause_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "GC pauses/s",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "ado",
    "keycloak",
    "rhbk",
    "openshift-prod"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Openshift-Prod",
          "value": "Openshift-Prod"
        },
        "hide": 0,
        "includeAll": false,
        "label": "K8S",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "/^Openshift-(Prod|Dev)$/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": "keycloak|rhbk|sso",
        "current": {
          "selected": true,
          "text": "keycloak",
          "value": "keycloak"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(jvm_memory_used_bytes, namespace)",
        "includeAll": false,
        "label": "Namespace",
        "multi": false,
        "name": "namespace",
        "query": {
          "query": "label_values(jvm_memory_used_bytes, namespace)",
          "refId": "StandardVariableQuery"
        },
        "regex": "/keycloak|rhbk|sso/i",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(jvm_memory_used_bytes{namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "query": {
          "query": "label_values(jvm_memory_used_bytes{namespace=~\"$namespace\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "OpenShift \u2014 Keycloak Metrics",
  "uid": "ado-keycloak-metrics",
  "version": 2
}
{% endraw %}
